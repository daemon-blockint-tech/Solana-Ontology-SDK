{
  "name": "@solana-ontology/generator-rust",
  "version": "0.1.0",
  "description": "Rust code generator stub for the Solana Ontology SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "@solana-ontology/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^3.2.6",
    "@types/node": "^20.14.0"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/daemon-blockint-tech/Solana-Ontology-SDK/tree/main/packages/generator-rust#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daemon-blockint-tech/Solana-Ontology-SDK.git",
    "directory": "packages/generator-rust"
  },
  "bugs": {
    "url": "https://github.com/daemon-blockint-tech/Solana-Ontology-SDK/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
