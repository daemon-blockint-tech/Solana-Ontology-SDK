{
  "name": "@solana-ontology/sdk",
  "version": "0.2.0",
  "description": "Runtime SDK for the Solana Ontology with @solana/kit and web3.js v1 adapter",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo src/generated"
  },
  "dependencies": {
    "@solana-ontology/core": "workspace:*",
    "@solana/spl-token": "^0.4.9",
    "@solana/web3.js": "^1.95.0"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^3.2.6",
    "@types/node": "^20.14.0"
  },
  "peerDependencies": {
    "@solana/kit": "^7.0.0"
  },
  "peerDependenciesMeta": {
    "@solana/kit": {
      "optional": true
    }
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/daemon-blockint-tech/Solana-Ontology-SDK/tree/main/packages/sdk#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daemon-blockint-tech/Solana-Ontology-SDK.git",
    "directory": "packages/sdk"
  },
  "bugs": {
    "url": "https://github.com/daemon-blockint-tech/Solana-Ontology-SDK/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
