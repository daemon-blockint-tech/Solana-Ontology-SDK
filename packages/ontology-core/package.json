{
  "name": "@solana-ontology/core",
  "version": "0.1.0",
  "description": "Core types, loader, and validator for the Solana Ontology SDK",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc && node -e \"require('fs').copyFileSync('src/schema.json','dist/schema.json')\"",
    "test": "vitest run",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "dependencies": {
    "yaml": "^2.4.0",
    "ajv": "^8.13.0",
    "ajv-formats": "^3.0.1"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^3.2.6",
    "@types/node": "^20.14.0"
  },
  "license": "Apache-2.0",
  "homepage": "https://github.com/daemon-blockint-tech/Solana-Ontology-SDK/tree/main/packages/ontology-core#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daemon-blockint-tech/Solana-Ontology-SDK.git",
    "directory": "packages/ontology-core"
  },
  "bugs": {
    "url": "https://github.com/daemon-blockint-tech/Solana-Ontology-SDK/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}
